#Application
ENV=local

#Database
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=name

#SQLAlchemy URLs used for testing and Alembic in local/dev
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

#Separate test DB (if you want to run a local test DB with Docker)
TEST_DATABASE_URL=postgresql+psycopg2://${TEST_POSTGRES_USER}:${TEST_POSTGRES_PASSWORD}@${TEST_POSTGRES_HOST}:${TEST_POSTGRES_PORT}/${TEST_POSTGRES_DB}

#Auth (Supabase Auth integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=